  "design_notes": {
    "philosophy": "Iron Man HUD. Multi-accent: each activity type gets a distinct color. Arc Reactor cyan for tools, J.A.R.V.I.S. lavender for agents, muted teal for todos. Holographic blue-cyan icons provide per-metric scanning fingerprints.",
    "color_vocabulary": {
      "240_recessive_gray": "Holographic UI framework / structural elements",
      "51_arc_reactor":    "Tool activity / System processing / High intensity",
      "141_jarvis":        "Agent activity / AI processing / J.A.R.V.I.S.",
      "73_subsystem":      "Todo activity / Subsidiary tasks",
      "214_faceplate_gold": "Warning / Attention needed",
      "196_armor_red":     "Critical threshold / Danger",
      "46_neon_green":     "Objective complete / Clean state",
      "74-159_holograms":  "Passive HUD elements (L2 icons) — unique blue-cyan variations"
    }
  }
}

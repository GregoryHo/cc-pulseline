{
  "$schema": "../../docs/theme-schema.json",
  "theme": "stark-hud",
  "author": "Gemini",
  "description": "Iron Man aesthetic: Arc Reactor cyan, Armor red, Faceplate gold, J.A.R.V.I.S. holographic grays.",

  "colors": {
    "emphasis": {
      "primary": 255,
      "secondary": 248,
      "structural": 242,
      "separator": 238
    },
    "alerts": {
      "critical": 196,
      "warning": 214,
      "git_dirty": 208,
      "high_burn": 198
    },
    "active": {
      "accent": 51,
      "success": 46,
      "git_clean": 39
    }
  },

  "palette_mapping": {
    "emphasis_primary": 255,
    "emphasis_secondary": 248,
    "emphasis_structural": 242,
    "emphasis_separator": 238,

    "alert_red": 196,
    "alert_orange": 208,
    "alert_magenta": 198,

    "active_cyan": 51,
    "active_purple": 141,
    "active_teal": 73,
    "active_amber": 214,
    "active_coral": 203,

    "stable_blue": 39,
    "stable_green": 46,

    "indicator_claude_md": 74,
    "indicator_rules": 74,
    "indicator_memory": 74,
    "indicator_hooks": 74,
    "indicator_mcp": 74,
    "indicator_skills": 74,
    "indicator_duration": 74,

    "completed_check": 46,

    "cost_base": 248,
    "cost_low_rate": 74,
    "cost_med_rate": 214,
    "cost_high_rate": 196
  },

  "light_emphasis": {
    "primary": 232,
    "secondary": 238,
    "structural": 244,
    "separator": 250
  },

  "design_notes": {
    "philosophy": "Iron Man HUD. Multi-accent: each activity type gets a distinct color. Arc Reactor cyan for tools, J.A.R.V.I.S. lavender for agents, muted teal for todos. Holographic cyan-blue icons instead of ghosted grays.",
    "color_vocabulary": {
      "51_arc_reactor":    "Tool activity / System processing",
      "141_jarvis":        "Agent activity / AI processing",
      "73_subsystem":      "Todo activity / Subsidiary tasks",
      "214_faceplate_gold": "Warning / Attention needed",
      "196_armor_red":     "Critical threshold / Danger",
      "46_neon_green":     "Objective complete / Clean state",
      "74_holographic":    "Passive HUD elements (L2 icons)"
    }
  }
}
